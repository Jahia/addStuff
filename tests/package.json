    "cypress-terminal-report": "^7.4.0",
    "cypress-wait-until": "^3.0.1",
    "graphql": "^15.10.3",
    "graphql-tag": "^2.12.7",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "^2.2.0",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
